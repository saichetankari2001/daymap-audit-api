NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5444/daymap_audit

# --- Archival job (src/jobs/archival) ---
# Entries with timestampUtc older than this many days get archived out of
# hot storage. Harry: production will likely be one week to one month;
# keep this short (e.g. 1) for local testing.
RETENTION_DAYS=30
# Where archived entries are written - one .jsonl file per calendar day.
COLD_STORAGE_DIR=./cold-storage
# Rows processed per archival batch, to avoid loading a huge backlog into
# memory in one go.
ARCHIVE_BATCH_SIZE=500
# Cron schedule used by `npm run archive:schedule`.
ARCHIVAL_CRON="0 2 * * *"
